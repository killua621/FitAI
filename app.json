{
  "expo": {
    "name": "ScholzFit",
    "slug": "scholzfit",
    "scheme": "scholzfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "experiments": { "typedRoutes": true },
    "plugins": ["expo-router"],
    "ios": { "supportsTablet": true },
    "android": { "edgeToEdgeEnabled": true },
    "web": { "bundler": "metro", "output": "static" }
  }
}
