{
  "expo": {
    "name": "ScholzFit",
    "slug": "scholzfit",
    "scheme": "scholzfit",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.scholzfit.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "monochromeImage": "./assets/images/monochrome-icon.png",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#100D13"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "icon": "./assets/images/icon.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2e64a846-abdb-4639-8f6c-28daf95c233b"
      }
    }
  }
}